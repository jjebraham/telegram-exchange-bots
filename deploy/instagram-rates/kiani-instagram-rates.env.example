# The local backend returns the same raw USDT/IRR and USDT/TRY inputs used by the bot.
KIANI_RATES_URL=http://127.0.0.1:8000/api/rates/current
PRICING_DB_PATH=/home/kianirad2020/send_changes/pricing_settings.db

# The output directory must match the Nginx alias in kiani-instagram-rates.nginx.conf.
INSTAGRAM_IMAGE_OUTPUT_DIR=/var/lib/kiani-instagram-rates/public
INSTAGRAM_PUBLIC_MEDIA_BASE_URL=https://miniapp.kiani.exchange/instagram-rates
INSTAGRAM_STATE_FILE=/home/kianirad2020/.local/state/kiani-instagram-rates/state.json

# story produces the requested 9:16 image and requires a Business account.
# Choose feed for a 4:5 image if this professional account is Creator.
INSTAGRAM_PUBLISH_MODE=story

# Set these from the Meta app. Never commit real tokens to the repository.
INSTAGRAM_GRAPH_BASE_URL=https://graph.facebook.com
INSTAGRAM_GRAPH_API_VERSION=vXX.0
INSTAGRAM_USER_ID=YOUR_INSTAGRAM_PROFESSIONAL_ACCOUNT_ID
INSTAGRAM_ACCESS_TOKEN=YOUR_LONG_LIVED_PUBLISH_TOKEN

# Optional: set an explicit font path if the system font is installed elsewhere.
# VAZIRMATN_FONT_PATH=/usr/share/fonts/truetype/vazirmatn/Vazirmatn[wght].ttf

