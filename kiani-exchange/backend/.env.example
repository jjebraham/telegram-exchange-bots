# Copy this file to .env on the server. Never commit the real .env file.

# Telegram admin bot
TELEGRAM_BOT_TOKEN=replace_with_rotated_bot_token
TELEGRAM_ADMIN_CHAT_ID=replace_with_admin_chat_id

# EHRAZ API
EHRAZ_TOKEN=replace_with_ehraz_token
# Keep true only while intentionally using mock verification.
USE_MOCK_EHRAZ=true

# Ghasedak SMS API
GHASEDAK_API_KEY=replace_with_ghasedak_api_key
GHASEDAK_LINE_NUMBER=replace_with_line_number
GHASEDAK_TEMPLATE_NAME=replace_with_template_name

# Wallex API
WALLEX_API_KEY=replace_with_wallex_api_key

# Proxy credentials used with the rotating proxy list
PROXY_USERNAME=replace_with_proxy_username
PROXY_PASSWORD=replace_with_proxy_password

# Optional dedicated proxy URL for Telegram transaction notifications.
# Leave blank to send directly.
TRANSACTION_PROXY_URL=

# JWT signing secret. Use a long random value and do not change it casually,
# because changing it invalidates existing login tokens.
JWT_SECRET_KEY=replace_with_long_random_secret

# Admin panel credentials
ADMIN_PANEL_USERNAME=replace_with_admin_username
ADMIN_PANEL_PASSWORD=replace_with_strong_admin_password
SUPPORT_PANEL_USERNAME=replace_with_support_username
SUPPORT_PANEL_PASSWORD=replace_with_strong_support_password
VIEWER_PANEL_USERNAME=replace_with_viewer_username
VIEWER_PANEL_PASSWORD=replace_with_strong_viewer_password

# Database
DATABASE_URL=sqlite:///./users.db
