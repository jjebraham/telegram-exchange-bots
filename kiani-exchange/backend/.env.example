# Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_at_least_32_random_characters
ACCESS_TOKEN_EXPIRE_HOURS=4
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin roles (no source-code defaults)
ADMIN_PANEL_USERNAME=admin
ADMIN_PANEL_PASSWORD=replace_with_a_strong_admin_password
SUPPORT_PANEL_USERNAME=
SUPPORT_PANEL_PASSWORD=
VIEWER_PANEL_USERNAME=
VIEWER_PANEL_PASSWORD=

# Browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=https://miniapp.peerexo.com,https://kianiapp.peerexo.com

# Telegram
# TELEGRAM_BOT_TOKEN is the customer/user bot when used by older integrations.
TELEGRAM_BOT_TOKEN=your_customer_telegram_bot_token_here
TELEGRAM_USER_BOT_TOKEN=your_customer_telegram_bot_token_here
TELEGRAM_ADMIN_BOT_TOKEN=your_admin_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here

# EHRAZ
EHRAZ_TOKEN=your_ehraz_token_here
# Semicolon- or comma-separated authenticated proxy URLs. Leave empty for direct access.
EHRAZ_PROXY_LIST=
KYC_TEST_MODE=false
ALLOW_KYC_TEST_MODE=false

# Ghasedak SMS
GHASEDAK_API_KEY=your_ghasedak_api_key_here
GHASEDAK_LINE_NUMBER=your_line_number_here
GHASEDAK_TEMPLATE_NAME=your_template_name_here
# Example shape only; do not commit real proxy credentials.
GHASEDAK_PROXY_FORMAT=
GHASEDAK_PROXY_POOL_START=1
GHASEDAK_PROXY_POOL_END=100

# Market/rate providers
# WALLEX_API_KEY is optional for public market data but can be configured when needed.
WALLEX_API_KEY=
WALLEX_BASE_URL=https://api.wallex.ir/v1
# Comma- or semicolon-separated host:port entries. Keep credentials separate.
PRICE_PROXY_HOSTS=
PRICE_PROXY_USERNAME=
PRICE_PROXY_PASSWORD=
PRICE_PROXY_MAX_RETRIES=2
RATE_HTTP_TIMEOUT_SECONDS=4

# KYC private uploads
# KYC_UPLOAD_DIR=/absolute/private/path/kyc_uploads
KYC_MAX_IMAGE_BYTES=10485760

# Transaction outbound proxy (optional)
TRANSACTION_PROXY_URL=
