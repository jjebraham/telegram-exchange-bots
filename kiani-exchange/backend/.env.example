# Copy this file to .env on the server. Never commit the real .env file.
# Secret values are intentionally blank so copying this template cannot enable
# a service with public/default credentials.

# Telegram admin bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# EHRAZ API
EHRAZ_TOKEN=
# Keep true only while intentionally using mock verification.
USE_MOCK_EHRAZ=true

# Ghasedak SMS API
GHASEDAK_API_KEY=
GHASEDAK_LINE_NUMBER=
GHASEDAK_TEMPLATE_NAME=

# Wallex API
WALLEX_API_KEY=

# Proxy credentials used with the rotating proxy list
PROXY_USERNAME=
PROXY_PASSWORD=

# Optional dedicated proxy URL for Telegram transaction notifications.
# Leave blank to send directly.
TRANSACTION_PROXY_URL=

# JWT signing secret. Use a long random value. Changing it invalidates existing
# login tokens, which is appropriate after a credential exposure incident.
JWT_SECRET_KEY=

# Admin panel credentials. Leave an unused role blank to disable it.
ADMIN_PANEL_USERNAME=
ADMIN_PANEL_PASSWORD=
SUPPORT_PANEL_USERNAME=
SUPPORT_PANEL_PASSWORD=
VIEWER_PANEL_USERNAME=
VIEWER_PANEL_PASSWORD=

# Database
DATABASE_URL=sqlite:///./users.db
