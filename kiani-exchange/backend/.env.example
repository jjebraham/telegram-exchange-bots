# Copy this file to .env on the server. Never commit the real .env file.

# Ghasedak SMS API
GHASEDAK_API_KEY=replace_with_ghasedak_api_key
GHASEDAK_LINE_NUMBER=replace_with_line_number
GHASEDAK_TEMPLATE_NAME=ghasedak2

# EHRAZ API
EHRAZ_TOKEN=replace_with_ehraz_token
# false = real EHRAZ; true = testing/mock mode only
USE_MOCK_EHRAZ=false

# Telegram bots
# Normal/customer-facing bot token.
TELEGRAM_BOT_TOKEN=replace_with_user_bot_token
# Optional explicit alias for the customer bot. Recommended while legacy admin helpers remain.
TELEGRAM_USER_BOT_TOKEN=replace_with_user_bot_token
# Optional customer bot username without @. If blank, the backend resolves it with getMe.
TELEGRAM_USER_BOT_USERNAME=
# Dedicated admin notification bot. Registration, login, KYC and order alerts use this token.
TELEGRAM_ADMIN_BOT_TOKEN=replace_with_rotated_admin_bot_token
# Numeric Telegram user/group/chat ID that receives admin notifications.
TELEGRAM_ADMIN_CHAT_ID=replace_with_admin_chat_id

# KYC uploads
# Defaults to backend/kyc_uploads when left blank/not set.
KYC_UPLOAD_DIR=
# Maximum bytes per uploaded image; default is 10485760 (10 MiB).
KYC_MAX_IMAGE_BYTES=10485760

# Profile images
# Defaults to backend/profile_uploads when left blank/not set.
PROFILE_UPLOAD_DIR=
# Maximum bytes per profile image; default is 5242880 (5 MiB).
PROFILE_MAX_IMAGE_BYTES=5242880

# Wallex API
WALLEX_API_KEY=replace_with_wallex_api_key

# Proxy credentials used with the rotating proxy list
PROXY_USERNAME=replace_with_proxy_username
PROXY_PASSWORD=replace_with_proxy_password
# Optional dedicated proxy URL for Telegram transaction notifications.
TRANSACTION_PROXY_URL=

# JWT signing secret
JWT_SECRET_KEY=replace_with_long_random_secret

# Admin panel credentials
ADMIN_PANEL_USERNAME=replace_with_admin_username
ADMIN_PANEL_PASSWORD=replace_with_strong_admin_password
SUPPORT_PANEL_USERNAME=replace_with_support_username
SUPPORT_PANEL_PASSWORD=replace_with_strong_support_password
VIEWER_PANEL_USERNAME=replace_with_viewer_username
VIEWER_PANEL_PASSWORD=replace_with_strong_viewer_password

# Database
DATABASE_URL=sqlite:///./users.db
