[Unit]
Description=Import verified publisher history for AlanChande website
After=network.target

[Service]
Type=oneshot
User=kianirad2020
Group=kianirad2020
WorkingDirectory=/home/kianirad2020/alanchande-site/website
EnvironmentFile=/home/kianirad2020/.config/alanchande-api.env
ExecStart=/home/kianirad2020/alanchande-site/website/.venv/bin/python -m api.import_verified_history --apply
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/home/kianirad2020/telegram_bot_repo/channel_split
ReadWritePaths=/var/lib/alanchande

[Install]
WantedBy=multi-user.target

