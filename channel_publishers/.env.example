# Keep real tokens/IDs only in the server .env. Never commit them.
ALANCHANDE_BOT_TOKEN=
ALANCHANDE_CHANNEL_ID=
KIANI_BOT_TOKEN=
KIANI_CHANNEL_ID=

# Safety switch. Leave false until the two test channels are ready.
POSTING_ENABLED=false

# HTTP source settings
HTTP_TIMEOUT_SECONDS=12
HTTP_USER_AGENT=AlanChandeChannelPublisher/0.1
BANK_RATES_PROVIDER=doviz_com

# Optional future provider
NOSYAPI_KEY=

# Temporary input for the Kiani test-card renderer.
# Later this will be replaced by the production pricing adapter.
# Example: {"TRY":{"buy":4600,"sell":4770},"USD":{"buy":228000,"sell":229500},"EUR":{"buy":263000,"sell":265000}}
KIANI_RATES_JSON=
