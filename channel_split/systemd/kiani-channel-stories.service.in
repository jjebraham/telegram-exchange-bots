[Unit]
Description=Share the confirmed daily Kiani rates photo to both channel stories
After=network-online.target
Wants=network-online.target
ConditionPathExists=@HOME@/.config/kiani-stories/ready

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@PROJECT@
Environment=HOME=@HOME@
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=@VENV@/bin/python @PROJECT@/kiani_story_worker.py run
TimeoutStartSec=240
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@HOME@/.local/share/kiani-stories @HOME@/.local/state/kiani-stories
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitCORE=0
StandardOutput=journal
StandardError=journal
