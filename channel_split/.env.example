# Copy to a server-side .env file or export these variables in your shell.
# NEVER commit real BotFather tokens.

ALANCHANDE_TELEGRAM_BOT_TOKEN=
ALANCHANDE_CHANNEL_ID=@alanchandetest

KIANI_TELEGRAM_BOT_TOKEN=
KIANI_CHANNEL_ID=@kianiexchangetest

# Optional override; defaults to production Kiani miniapp API.
KIANI_RATES_URL=https://miniapp.kiani.exchange/api/rates/current


# Reuse the same outbound market-data proxy pool as the active Kiani backend.
# Keep credentials separate from host:port entries.
PRICE_PROXY_HOSTS=
PRICE_PROXY_USERNAME=
PRICE_PROXY_PASSWORD=
PRICE_PROXY_MAX_RETRIES=2
RATE_HTTP_TIMEOUT_SECONDS=4
