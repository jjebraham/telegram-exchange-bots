# Copy to a server-side .env file or export these variables in your shell.
# NEVER commit real BotFather tokens.

ALANCHANDE_TELEGRAM_BOT_TOKEN=
ALANCHANDE_CHANNEL_ID=@alanchandetest

KIANI_TELEGRAM_BOT_TOKEN=
KIANI_CHANNEL_ID=@kianiexchangetest

# Customer contact links used in Kiani transaction posts.
KIANI_CONTACT_TELEGRAM=https://t.me/TL905411603664
KIANI_CONTACT_WHATSAPP=https://wa.me/905392905686

# Shared pricing database controlled by https://peerexo.com/alanchande/.
# The Kiani channel publisher reads these percentages on every post run.
KIANI_PRICING_DB_PATH=/home/kianirad2020/send_changes/pricing_settings.db


# Reuse the same outbound market-data proxy pool as the active Kiani backend.
# Keep credentials separate from host:port entries.
PRICE_PROXY_HOSTS=
PRICE_PROXY_USERNAME=
PRICE_PROXY_PASSWORD=
PRICE_PROXY_MAX_RETRIES=2
RATE_HTTP_TIMEOUT_SECONDS=4


# Market safety gate.
# Keep "shadow" while validating source coverage. Switch to "enforce" only
# after independent verifier sources are wired and shadow logs are clean.
MARKET_SAFETY_MODE=shadow

# Private Telegram destination for BLOCKED/SUSPICIOUS/recovery alerts.
# The AlanChande bot token is reused by default; set a separate admin bot token
# only if you want alerts sent by another bot.
ALANCHANDE_ADMIN_CHAT_ID=
ALANCHANDE_ADMIN_BOT_TOKEN=
MARKET_SAFETY_ALERT_REPEAT_MINUTES=60


# Independent Turkey FX/gold verifier freshness limit.
ALTINKAYNAK_MAX_AGE_MINUTES=90


# Maximum age accepted for third-party bank-rate consensus sources.
# This is intentionally more tolerant than market tick feeds because bank
# retail quotes may remain unchanged outside active banking hours.
BANK_AGGREGATOR_MAX_AGE_MINUTES=720


# Maximum age accepted for Pashizi Iran FX verification. The larger window
# allows the overnight market pause while still failing closed on stale data.
IRAN_FX_EXTERNAL_MAX_AGE_MINUTES=900

# Maximum age accepted for Dolarchand Iran gold/coin verification.
IRAN_GOLD_EXTERNAL_MAX_AGE_MINUTES=240
