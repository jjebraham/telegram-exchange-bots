# Dedicated bot token created with @BotFather. Never commit the real token.
BOT_TOKEN=123456:replace-me

# Numeric channel ID is strongly recommended.
CHANNEL_ID=-1001234567890
CHANNEL_URL=https://t.me/alanchande_com

# Your Telegram numeric user ID(s), comma-separated.
ADMIN_IDS=123456789

DB_PATH=/var/lib/alanchande-referral/referral_bot.db
LOG_LEVEL=INFO

# New campaigns inherit these defaults. Scoring rules can be changed only while
# the campaign is still a draft; activation locks them for fairness/auditability.
DEFAULT_INVITES_PER_POINT=2
DEFAULT_MIN_STAY_HOURS=168
DEFAULT_MAX_POINTS=20
DEFAULT_NUM_WINNERS=5

# Qualification notifications are checked once per hour by default.
QUALIFICATION_CHECK_SECONDS=3600

# If a referred user starts the flow but does not join the channel, send one
# reminder after 15 minutes. The worker checks every 5 minutes by default.
PENDING_REMINDER_MINUTES=15
PENDING_REMINDER_CHECK_SECONDS=300

# Re-check unresolved pending referrals and a rate-limited batch of currently
# active referrals every 6 hours to heal missed Telegram membership events.
RECONCILIATION_CHECK_SECONDS=21600
RECONCILIATION_BATCH_SIZE=200

# Daily trend snapshots are upserted throughout the day. The participant nudge
# worker checks hourly by default. EARLY_SHARE_NUDGE_HOURS targets participants
# who already have a personal link but still have no pending/joined referral.
ANALYTICS_SNAPSHOT_SECONDS=3600
NUDGE_CHECK_SECONDS=3600
EARLY_SHARE_NUDGE_HOURS=2
ZERO_REFERRAL_NUDGE_HOURS=24
PROMO_ABANDON_NUDGE_HOURS=3

# Send one private admin digest per Istanbul calendar day. The worker checks
# hourly and sends after the configured Istanbul hour if it has not sent yet.
DAILY_DIGEST_HOUR_ISTANBUL=21
DAILY_DIGEST_CHECK_SECONDS=3600

# If a referrer receives a burst of automated join/leave/qualification messages,
# send at most this many during the window and summarize the suppressed events.
NOTIFICATION_WINDOW_SECONDS=600
NOTIFICATION_MAX_PER_WINDOW=5

# Critical Telegram membership checks retry transient network/rate-limit errors
# with exponential backoff. Permanent BadRequest/Forbidden errors are not retried.
TELEGRAM_RETRY_ATTEMPTS=4
TELEGRAM_RETRY_BASE_SECONDS=1

# SQLite backup utility settings. The recommended cron schedule runs every 6h.
BACKUP_DIR=/home/kianirad2020/alanchande-backups
BACKUP_RETENTION_DAYS=30

# Optional off-server backup. Install/configure rclone first, then point this at
# an rclone remote, e.g. gdrive:alanchande-backups or s3remote:bucket/path.
# Leave empty until the remote is configured and tested.
BACKUP_RCLONE_DEST=

# Backup failures can be sent to Telegram. If BACKUP_ALERT_CHAT_ID is empty, the
# first ADMIN_IDS value is used. Success alerts are off by default.
BACKUP_ALERT_CHAT_ID=
BACKUP_ALERT_ON_SUCCESS=0

# Optional one-command publisher for the meditation-channel campaign post.
# The bot must be an admin of this channel with permission to post messages.
# Public channels can use @username; private channels should use numeric -100... ID.
MEDITATION_CHANNEL_ID=@your_meditation_channel
# Optional: use a separate bot that is already admin of the meditation channel.
MEDITATION_POSTING_BOT_TOKEN=
# Deep-link target for contest participation. Keep this on the production referral bot.
CAMPAIGN_BOT_USERNAME=Alanchandebot
MEDITATION_PROMO_IMAGE=/home/kianirad2020/telegram_bot_repo/alanchande-referral-bot/assets/meditation-autumn-20260925.png
MEDITATION_INVITE_DEADLINE_FA="۱۷ مهر"
